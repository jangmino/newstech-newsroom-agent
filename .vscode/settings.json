{
  "editor.formatOnSave": true,
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "python.defaultInterpreterPath": "${workspaceFolder}/apps/api/.venv/bin/python",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["apps/api/tests"],
  "ruff.configuration": "${workspaceFolder}/apps/api/pyproject.toml",
  "typescript.tsdk": "apps/web/node_modules/typescript/lib",
  "terminal.integrated.cwd": "${workspaceFolder}"
}
