{
  "name": "@newstech/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "node scripts/test.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "pnpm typecheck && vite build",
