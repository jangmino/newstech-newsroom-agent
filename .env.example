# Common
APP_ENV=local
LOG_LEVEL=INFO
PUBLIC_DATA_MODE=mock
LIVE_API_ENABLED=false
FALLBACK_SNAPSHOT_ENABLED=true
WORKSHOP_ACCESS_CODE=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Gemini — local prototype
# Keep only in .env. Never use VITE_* for secrets.
GEMINI_AUTH_MODE=api_key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Gemini / Vertex AI — stage and event
# GEMINI_AUTH_MODE=vertex_ai
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-northeast3

# Public data APIs — backend only
OPENDART_API_KEY=
# Live OpenDART also requires LIVE_API_ENABLED=true and PUBLIC_DATA_MODE=live.
OPENDART_ENABLED=false
KOSIS_API_KEY=
# Live KOSIS also requires LIVE_API_ENABLED=true and PUBLIC_DATA_MODE=live.
KOSIS_ENABLED=false

# Gemini request limits (per process)
REQUESTS_PER_MINUTE=30
MAX_CONCURRENT_REQUESTS=8
# Public-data HTTP starts in a rolling 60 seconds / concurrent HTTP requests.
# Each provider has an independent budget. Cache hits and coalesced waiters cost no extra calls.
PUBLIC_DATA_REQUESTS_PER_MINUTE=30
PUBLIC_DATA_MAX_CONCURRENT_REQUESTS=2
# Successful normalized public data only; per process and per provider, no disk storage.
PUBLIC_DATA_CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=64
