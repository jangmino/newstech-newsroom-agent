# Common
APP_ENV=local
LOG_LEVEL=INFO
PUBLIC_DATA_MODE=mock
LIVE_API_ENABLED=false
FALLBACK_SNAPSHOT_ENABLED=true
WORKSHOP_ACCESS_CODE=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Gemini — local prototype
# Keep only in .env. Never use VITE_* for secrets.
GEMINI_AUTH_MODE=api_key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Gemini / Vertex AI — stage and event
# GEMINI_AUTH_MODE=vertex_ai
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-northeast3

# Public data APIs — backend only
OPENDART_API_KEY=
KOSIS_API_KEY=

# Event safety defaults
REQUESTS_PER_MINUTE=30
MAX_CONCURRENT_REQUESTS=8
CACHE_TTL_SECONDS=3600
