# Only build inputs may leave this checkout. Keep aligned with .dockerignore.
**
!.dockerignore
!.gcloudignore
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!infra/
!infra/Dockerfile
!infra/cloudbuild.yaml
!apps/
!apps/web/
!apps/web/package.json
!apps/web/index.html
!apps/web/tsconfig*.json
!apps/web/vite.config.ts
!apps/web/src/
!apps/web/src/**
!apps/api/
!apps/api/pyproject.toml
!apps/api/uv.lock
!apps/api/README.md
!apps/api/src/
!apps/api/src/**
**/.env*
**/*.pem
**/*.key
**/*service-account*.json
**/credentials*.json
**/__pycache__/**
**/*.pyc
**/.DS_Store
**/*.test.tsx
apps/web/src/test/**
